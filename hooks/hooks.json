{
  "description": "rootpath safety guard: no real remediation without a prior dry run, nothing during a change freeze",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_rootpath_)?oncall__(rollback_service|restart_service|set_feature_flag)",
        "hooks": [
          { "type": "command", "command": "uv run --quiet --directory \"${CLAUDE_PLUGIN_ROOT}\" python -m rootpath.guard", "timeout": 20 }
        ]
      }
    ]
  }
}
